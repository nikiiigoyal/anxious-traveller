# ─────────────────────────────────────────────────────────────
# Anxious Traveller — Llama API configuration
# Copy this file to `.env` in this same folder (server/.env)
# and fill in your real key. NEVER commit the real .env.
# ─────────────────────────────────────────────────────────────

# Your hackathon API key (Meta Model API credits, or partner
# credits such as Fireworks / Baseten — any OpenAI-compatible key works)
LLM_API_KEY=

# Base URL of the OpenAI-compatible chat endpoint.
# Meta Model API: use the URL shown in your hackathon portal / dev.meta.ai console
# Fireworks:      https://api.fireworks.ai/inference/v1
LLM_BASE_URL=

# Model name.
# Meta Model API: the Llama model name listed in your portal (e.g. Llama-4-Muse / llama-3.3-70b)
# Fireworks:      accounts/fireworks/models/llama-v3p3-70b-instruct
LLM_MODEL=

# Optional: server port (defaults to 3005)
# PORT=3005
